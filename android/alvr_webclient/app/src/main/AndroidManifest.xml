<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- USB Host API (IMU HID) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <!-- Internet (ALVR Server WebSocket) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CPU wakelock (while IMU polling) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Camera permission is required for Android to show the USB permission dialog for UVC
         devices (e.g. XREAL Air 2 Ultra which has a pass-through camera interface).
         Without this, UsbUserPermissionManager silently blocks the USB permission request
         on Android 12+ when the device is classified as a USB Video Class (UVC) device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Microphone permission for ALVR audio input (web client getUserMedia / AudioRecord). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Access local network for Android 17+ or later. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlvrWebClient">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Detect USB device connection -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

    </application>
</manifest>
